// A predicate for receipts with a transfer of at least 1000 USDC or USDT (both have 6 decimals):
//   cargo run -q -- examples/large.yes --stream:receipt < examples/receipts.ndjson
// or for a single receipt:
//   cargo run -q -- examples/large.yes --bind:receipt=@examples/receipt.json

let STABLES = [b"a0b86991c6218b36c1d19d4a2e9eb0ce3606eb48", b"dac17f958d2ee523a2206206994597c13d831ec7"];

receipt.status == b"01"
&& any(receipt.logs, fn(log) {
  let t = event(log, "Transfer(address indexed from, address indexed to, uint256 amount)");
  log.address in STABLES && t != null && t.amount >= 1000 * 1000000
})
