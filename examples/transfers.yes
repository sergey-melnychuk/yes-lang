// Decodes ERC-20 transfers of USDC and USDT from the logs of a transaction receipt:
//   cargo run -q -- examples/transfers.yes --stream:receipt < examples/receipts.ndjson
// or for a single receipt:
//   cargo run -q -- examples/transfers.yes --bind:receipt=@examples/receipt.json
//
// examples/receipts.ndjson: receipts of the first 30 transactions of mainnet block 26040477
//
// expect: [{"amount": 3300000000, "from": "0xc54f706f1faff6b22621e9d7a77e650c13a2fbfa", "to": "0xa3c2a287f7408d4abd34c00b47fc39f3bac324e4", "token": "USDT"}]

// event Transfer(address indexed from, address indexed to, uint256 value)
let TRANSFER = keccak("Transfer(address,address,uint256)");

let TOKENS = [
  {symbol: "USDC", address: b"a0b86991c6218b36c1d19d4a2e9eb0ce3606eb48"},
  {symbol: "USDT", address: b"dac17f958d2ee523a2206206994597c13d831ec7"},
];

fn token(address) {
  let found = filter(TOKENS, fn(t) { t.address == address });
  if found == [] { null } else { found[0].symbol }
}

// ERC-721 transfers have the same signature, but the token id is indexed (4 topics)
fn is_transfer(log) {
  len(log.topics) == 3 && log.topics[0] == TRANSFER && token(log.address) != null
}

// indexed addresses are the last 20 bytes of 32-byte topics, the amount is in the data
fn decode(log) {
  {
    token: token(log.address),
    from: log.topics[1][12..],
    to: log.topics[2][12..],
    amount: int(log.data),
  }
}

let transfers = map(filter(receipt.logs, is_transfer), decode);
if transfers == [] { null } else { transfers }
