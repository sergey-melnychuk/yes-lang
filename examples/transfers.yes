// Decodes ERC-20 transfers of USDC and USDT from the logs of a transaction receipt:
//   cargo run -q -- examples/transfers.yes --stream:receipt < examples/receipts.ndjson
// or for a single receipt:
//   cargo run -q -- examples/transfers.yes --bind:receipt=@examples/receipt.json
//
// examples/receipts.ndjson: receipts of the first 30 transactions of mainnet block 26040477
//
// expect: [{"amount": 3300000000, "from": "0xc54f706f1faff6b22621e9d7a77e650c13a2fbfa", "to": "0xa3c2a287f7408d4abd34c00b47fc39f3bac324e4", "token": "USDT"}]

let TOKENS = {
  "0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48": "USDC",
  "0xdac17f958d2ee523a2206206994597c13d831ec7": "USDT",
};

// 'null' for other events, and for ERC-721 transfers: the same signature, but the token id
// is indexed too
fn transfer(log) {
  let symbol = TOKENS[hex(log.address)];
  let t = event(log, "Transfer(address indexed from, address indexed to, uint256 amount)");
  if symbol == null || t == null { return null; }
  {token: symbol, from: t.from, to: t.to, amount: t.amount}
}

let transfers = filter(map(receipt.logs, transfer), fn(t) { t != null });
if transfers == [] { null } else { transfers }
